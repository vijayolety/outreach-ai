// web/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// NEXTAUTH & USER MODELS
// -----------------------------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?   // Profile picture URL
  passwordHash  String?   // Used for local credentials login
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  
  // Relations to Example app entities
  campaigns     Campaign[]
  settings      Settings?
  smtpAccounts  SmtpAccount[] // Replaces IntegrationAccount
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// -----------------------------------------------------------------------------
// CORE DOMAIN MODELS (Example App Logic)
// -----------------------------------------------------------------------------

model SmtpAccount {
  id               String     @id @default(cuid())
  userId           String   
  name             String     // e.g., "Example Main Sales"
  host             String
  port             Int
  username         String
  encryptedPass    String     // AES-256 encrypted at rest
  encryptionType   String     @default("TLS") // TLS, SSL, NONE
  fromEmail        String
  fromName         String
  isVerified       Boolean    @default(false)
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns        Campaign[] 
}

model Campaign {
  id               String            @id @default(cuid())
  userId           String            
  name             String?
  status           String            @default("draft")
  tone             String?
  cta              String?
  senderName       String?           @default("The Example Team")
  context          String?
  businessType     String?
  locationContext  String?
  followup1Delay   Int               @default(3)
  followup2Delay   Int               @default(7)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads            Lead[]
  errors           LeadUploadError[]
  
  aiProviderId     String?
  
  // Link to strict Multi-SMTP configuration
  smtpAccountId    String?
  smtpAccount      SmtpAccount?      @relation(fields: [smtpAccountId], references: [id])

  strategyId       String?
  strategy         Strategy?         @relation(fields: [strategyId], references: [id])
}

model Lead {
  id           String    @id @default(cuid())
  campaignId   String
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  jobTitle     String
  companyName  String
  email        String
  sector       String?
  city         String?
  zipcode      String?
  country      String?
  linkedinUrl  String?
  notes        String?
  status       String    @default("Cold")
  emailSubject String?
  emailBody    String?
  aiRationale  String?
  sent         Boolean   @default(false)
  opened       Boolean   @default(false)
  replied      Boolean   @default(false)
  isApproved   Boolean   @default(false)
  isPaused     Boolean   @default(false)
  messages     Message[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([campaignId])
  @@unique([campaignId, email])
}

model Message {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  role      String   
  content   String
  messageId String?  @unique
  createdAt DateTime @default(now())
}

model LeadUploadError {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  rowNumber  Int
  field      String
  message    String
  createdAt  DateTime @default(now())
  @@index([campaignId])
}

model Settings {
  id                   String @id @default(cuid())
  userId               String @unique
  user                 User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Cleaned up API keys logic
  geminiApiKey         String?
  groqApiKey           String?
  openaiApiKey         String?
  claudeApiKey         String?
  aiProvider           String  @default("groq")
  
  maxEmailsPerHour     Int     @default(50)
  followupDelayOptions String  @default("1,3,5,7,10,14")
  
  // Prompt Configuration
  basePrompt           String? @default("You are a world-class B2B copywriter. Anchor the hook in lead notes. Use short sentences.")
  promptRole           String? @default("Elite B2B sales copywriter specializing in highly technical GTM cold outreach.")
  promptProduct        String? @default("Example: Advanced AI-driven outreach automation.")
  promptPersona        String? @default("VP of Sales, Growth Lead, or Founder.")
  promptPainPoint      String? @default("Low reply rates and time-consuming manual research.")
  promptSocialProof    String? @default("Helped 50+ SaaS companies double their pipeline.")
  promptTone           String? @default("Peer-to-peer, conversational, and direct.")
  promptCta            String? @default("Is this on your radar for Q3?")
}

model Strategy {
  id           String   @id @default(cuid())
  name         String
  role         String?
  product      String?
  persona      String?
  painPoint    String?
  socialProof  String?
  tone         String?
  cta          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  campaigns    Campaign[]
}